POSTGRES_USER=netcapacity
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=netcapacity
DATABASE_URL=postgresql://netcapacity:change-me-locally@db:5432/netcapacity
RABBITMQ_DEFAULT_USER=netcapacity
RABBITMQ_DEFAULT_PASS=change-me-locally
AMQP_URL=amqp://netcapacity:change-me-locally@rabbitmq:5672/%2F
# Fila: rabbitmq no ambiente local; na AWS as instâncias usam QUEUE_BACKEND=sqs
QUEUE_BACKEND=rabbitmq
COLLECTION_MODE=simulated
POLL_INTERVAL_SECONDS=20
SIMULATED_DEVICES=8
ALERT_THRESHOLD_PERCENT=80
# For authorized SNMP only: set COLLECTION_MODE=snmp and mount a private inventory
# SNMP_COMMUNITY=use-a-read-only-secret

# Windows host collector runs separately, not as COLLECTION_MODE=snmp in Docker.
# Do not put real SNMP community in this file.
