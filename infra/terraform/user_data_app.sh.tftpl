#!/bin/bash
# Inicialização das instâncias da APLICAÇÃO (Auto Scaling Group).
# Log: /var/log/netcapacity-bootstrap.log
exec > >(tee -a /var/log/netcapacity-bootstrap.log) 2>&1
set -euxo pipefail

# 1) Docker + Compose plugin + Git
dnf install -y docker git
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# 2) Identidade da instância (IMDSv2)
TOKEN=$(curl -fsX PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -fs -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)

# 3) Código
APP_DIR=/opt/netcapacity
git clone --branch "${repo_branch}" --depth 1 "${repo_url}" "$APP_DIR"
cd "$APP_DIR"

# 4) Configuração (arquivo só na instância, nunca no Git)
cat > .env <<EOF
DATABASE_URL=${database_url}
QUEUE_BACKEND=sqs
SQS_QUEUE_URL=${sqs_queue_url}
AWS_REGION=${region}
ALERT_THRESHOLD_PERCENT=${threshold}
INSTANCE_ID=$INSTANCE_ID
LOKI_URL=${loki_url}
EOF
chmod 600 .env

# 5) Containers da aplicação + agentes de observabilidade
docker compose -f deploy/docker-compose.app.yml --env-file .env up -d --build
docker compose -f deploy/docker-compose.app.yml ps
echo "BOOTSTRAP OK $INSTANCE_ID"
