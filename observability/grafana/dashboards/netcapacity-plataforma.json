{
  "uid": "netcapacity-plataforma",
  "title": "NetCapacity — Plataforma e alta disponibilidade",
  "description": "Saúde técnica: ALB, instâncias, API, fila SQS, banco, Lambda e logs.",
  "tags": [
    "netcapacity"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 101,
      "type": "row",
      "title": "Alta disponibilidade",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 102,
      "type": "stat",
      "title": "Instâncias da aplicação respondendo",
      "description": "Instâncias cuja API responde ao Prometheus. Meta: 2 ou mais.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(up{job=\"app-api\"} == 1)",
          "legendFormat": "instâncias",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 103,
      "type": "timeseries",
      "title": "Alvos saudáveis no Load Balancer",
      "description": "",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 9,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "region": "default",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HealthyHostCount",
          "dimensions": {
            "TargetGroup": "*",
            "LoadBalancer": "*"
          },
          "statistic": "Minimum",
          "period": "60",
          "matchExact": false,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "id": "",
          "expression": "",
          "label": "saudáveis"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "region": "default",
          "namespace": "AWS/ApplicationELB",
          "metricName": "UnHealthyHostCount",
          "dimensions": {
            "TargetGroup": "*",
            "LoadBalancer": "*"
          },
          "statistic": "Maximum",
          "period": "60",
          "matchExact": false,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "id": "",
          "expression": "",
          "label": "não saudáveis"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 104,
      "type": "timeseries",
      "title": "Requisições no Load Balancer",
      "description": "",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 9,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "region": "default",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensions": {
            "LoadBalancer": "*"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": false,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "id": "",
          "expression": "",
          "label": "requisições/min"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "region": "default",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_Target_5XX_Count",
          "dimensions": {
            "LoadBalancer": "*"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": false,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "id": "",
          "expression": "",
          "label": "erros 5xx/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 105,
      "type": "row",
      "title": "Aplicação",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "panels": []
