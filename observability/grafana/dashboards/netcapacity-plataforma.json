        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "region": "default",
          "namespace": "AWS/SQS",
          "metricName": "ApproximateNumberOfMessagesVisible",
          "dimensions": {
            "QueueName": "netcapacity-samples-dlq"
          },
          "statistic": "Maximum",
          "period": "60",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "id": "",
          "expression": "",
          "label": "DLQ (falhas)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 111,
      "type": "timeseries",
      "title": "Produção x consumo (amostras/s)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
