      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(netcapacity_collector_published_samples_total[2m]))",
          "legendFormat": "publicadas (collector)",
