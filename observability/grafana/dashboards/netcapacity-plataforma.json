    {
      "id": 110,
      "type": "timeseries",
      "title": "Mensagens na fila",
      "description": "Se os processadores param, a fila cresce; ao voltarem, ela esvazia sem perder dados.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "region": "default",
          "namespace": "AWS/SQS",
          "metricName": "ApproximateNumberOfMessagesVisible",
          "dimensions": {
            "QueueName": "netcapacity-samples"
          },
          "statistic": "Maximum",
          "period": "60",
